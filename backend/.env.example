# ============================================================
# ZERO TRUST BACKEND - VARIABLES DE ENTORNO
# ============================================================

# ------------------------------------------------------------
# SERVIDOR
# ------------------------------------------------------------

PORT=3000
NODE_ENV=development

# ------------------------------------------------------------
# FRONTEND PERMITIDO POR CORS
# ------------------------------------------------------------

FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# AUTENTICACIÓN JWT
# ------------------------------------------------------------

# Utiliza una clave larga, aleatoria y privada en el archivo .env real.
JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_UNA_MUY_SEGURA

# Tiempo de duración del token
JWT_EXPIRES_IN=1h

# ------------------------------------------------------------
# USUARIO DE LA APLICACIÓN
# ------------------------------------------------------------

# Usuario de acceso
APP_USER_USERNAME=itzel

# Aquí debe colocarse solamente el hash bcrypt.
# Nunca escribas la contraseña real en este archivo.
APP_USER_PASSWORD_HASH=$2b$12$HASH_BCRYPT_DE_EJEMPLO

# ------------------------------------------------------------
# PROTECCIÓN DEL LOGIN
# ------------------------------------------------------------

# Ventana de tiempo para contabilizar intentos
LOGIN_WINDOW_MINUTES=10

# Máximo de solicitudes permitidas durante la ventana
LOGIN_MAX_ATTEMPTS=5